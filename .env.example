# Server-side only (Vercel Functions /api/*)
# Full JSON key of a Google Cloud service account with the Vertex AI User role
GOOGLE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# Resend (https://resend.com) — verified sender/domain in Resend dashboard
RESEND_API_KEY=re_...
CONTACT_EMAIL=ampliasolutions.pt@gmail.com
# Optional: from address (default noreply@ampliasolutions.pt — domain must be verified in Resend)
# RESEND_FROM=noreply@ampliasolutions.pt

# Optional: override contact form POST URL (default: /api/contact via Resend)
# VITE_CONTACT_ENDPOINT=/api/contact
